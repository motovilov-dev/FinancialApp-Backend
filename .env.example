# Скопируйте в .env и заполните перед запуском.
# Файл .env в .gitignore — туда складываем реальные значения.
APP_NAME=FinanceMac API
ENV=dev
SECRET_KEY=change-me-in-prod-please

# SQLite по умолчанию. Для Postgres:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/finance
DATABASE_URL=sqlite+aiosqlite:///./finance.db

# JWT
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_HOURS=48

# CORS (через запятую)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Email. Если USE_REAL_SMTP=0 — письма пишутся в ./var/mail/*.eml (dev).
# Порт 465 = implicit TLS; 587 = STARTTLS. Можно задать явно SMTP_USE_TLS=1/0.
USE_REAL_SMTP=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=auto
PUBLIC_BASE_URL=http://localhost:8000
